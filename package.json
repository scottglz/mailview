{
  "name": "mailview",
  "private": true,
  "version": "0.3.1",
  "description": "A read-only web UI for Mail-Archiver: search, read and download archived email, one account per person.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottglz/mailview.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "demo": "npm run build && node server/index.ts --demo",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test server/security.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18",
    "openid-client": "6.9.0",
    "postal-mime": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
