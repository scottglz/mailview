# Secrets for mailview. Copy to mailview.env (or your secret store) and never commit the filled-in file.

# Your OpenID Connect provider's client secret for mailview.
OIDC_CLIENT_SECRET=change-me

# One Mail-Archiver API key per person, created by that person's own (non-admin) Mail-Archiver user.
# Name: MAILVIEW_KEY_ + the label from MAILVIEW_USERS in upper case, "-" becomes "_".
MAILVIEW_KEY_ALICE=change-me
MAILVIEW_KEY_BOB=change-me
